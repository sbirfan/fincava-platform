# Copy this file to .env and fill in real values. Never commit .env.
# The verification-request feature (see doc/FINCAVA_PLATFORM_ADDENDUM_VERIFICATION.md)
# needs no additional secrets beyond what's already listed here.

NODE_ENV=development
PORT=5000

# Neon dashboard -> Connection Details (pooled connection string)
DATABASE_URL=

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Secret used to hash OTP codes server-side. Generate with: openssl rand -hex 32
# Must be different from SESSION_SECRET.
OTP_HASH_SECRET=

# Admin login password (single founder account, env-var based, no roles).
ADMIN_PASSWORD=

# Resend dashboard -> API Keys
RESEND_API_KEY=

# Verified sender identity in Resend, e.g. hello@fincava.com
EMAIL_FROM=

# Founder's personal email — receives notifications on new RFQs, sample
# requests, sourcing requests, verification requests, and registrations.
FOUNDER_EMAIL=

# Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
