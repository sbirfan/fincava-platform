{
  "name": "fincava-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FINCAVA — Green Coffee Buyer Relationship Platform",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run build --workspace shared && concurrently --kill-others \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace shared && npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npm run seed --workspace server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
